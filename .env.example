# Zweck:
#   Beispielkonfiguration fuer den Docker-Container und lokale Starts.
# Input/Output:
#   Diese Datei wird nach `.env` kopiert und mit den echten Arr-Werten befuellt.
# Wichtige Invarianten:
#   API-Keys gehoeren nur in `.env`, nie in Git.
# Debugging:
#   Wenn das UI "Nicht konfiguriert" zeigt, zuerst diese Werte pruefen.

APP_HOST=0.0.0.0
APP_PORT=8000
LOG_LEVEL=INFO
REQUEST_TIMEOUT_SECONDS=10

RADARR_URL=http://radarr:7878
RADARR_API_KEY=dein-radarr-api-key

SONARR_URL=http://sonarr:8989
SONARR_API_KEY=dein-sonarr-api-key
